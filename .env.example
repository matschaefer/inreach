# Retain existing DB credentials and volume identity on upgrades.
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=jobplatform_crawler
POSTGRES_PORT=5433
INREACH_DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/jobplatform_crawler
INREACH_API_BASE_URL=http://127.0.0.1:8080
# Generate a random value with at least 24 characters.
INREACH_INGESTION_TOKEN=
INREACH_POSTGRES_VOLUME=job-platform_postgres_data
INREACH_REDIS_VOLUME=job-platform_redis_data
CRAWL_INTERVAL_MINUTES=360
